# --- LLM ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# LLM_PROVIDER=anthropic
# OPENAI_API_KEY=your-openai-key
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o
# MAX_TOKENS=16384

# --- Target app under test ---
# The profile (repos, health checks, selectors) is loeb.json; see docs/profile.md.
# Relative paths in this file resolve against this file's directory.
# LOEB_PROFILE=examples/todo/loeb.json             # default: ./loeb.json
# LOEB_CONTEXT=                                    # overrides the profile's "context"
API_BASE_URL=http://localhost:8000
WEBSITE_URL=http://localhost:4321
# GITHUB_REPO=your-org/your-app                      # issues are filed with `gh`

# --- Test user ---
# TEST_EMAIL=test-user@example.com
# TEST_PASSWORD=your-test-password
# Optional: makes login() inject a Supabase session instead of filling the form
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# --- TTS, voice apps only (local server first, Deepgram fallback) ---
# POST {TTS_URL}/v1/tts {"text": ..., "streaming": false} -> 16-bit mono WAV
TTS_URL=http://127.0.0.1:8081
# DEEPGRAM_API_KEY=your-deepgram-key

# --- Side-effect verification ---
REDIS_HOST=localhost
REDIS_PORT=6379
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Notifications (optional) ---
# SLACK_BOT_TOKEN=xoxb-your-slack-token
# SLACK_CHANNEL=#alerts
