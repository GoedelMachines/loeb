# --- LLM ---
ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_MODEL=claude-sonnet-4-6
# LLM_PROVIDER=anthropic
# OPENAI_API_KEY=your-openai-key
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o

# --- Target app under test ---
BACKEND_DIR=/path/to/your-app-backend
FRONTEND_DIR=/path/to/your-app-frontend
TARGET_CONTEXT=examples/voice-assistant/target.md
TARGET_SERVICES=examples/voice-assistant/services.json
GITHUB_REPO=your-org/your-app
API_BASE_URL=http://localhost:8000
WEBSITE_URL=http://localhost:4321

# --- Test user ---
TEST_EMAIL=test-user@example.com
TEST_PASSWORD=your-test-password
# Optional: only for login(method="token") Supabase session injection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- TTS (local server first, Deepgram fallback) ---
TTS_URL=http://127.0.0.1:8081
DEEPGRAM_API_KEY=your-deepgram-key

# --- Side-effect verification ---
REDIS_HOST=localhost
REDIS_PORT=6379
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Notifications (optional) ---
SLACK_BOT_TOKEN=xoxb-your-slack-token
SLACK_CHANNEL=#alerts
