{
  "checks": [
    {"name": "API (FastAPI :8000)", "kind": "http", "probe": null, "fix": "start the API server"},
    {"name": "Website (:4321)", "kind": "http", "probe": null, "fix": "systemctl --user start app-website"},
    {"name": "LiveKit (:7880)", "kind": "tcp", "probe": ["127.0.0.1", 7880], "fix": "docker start livekit"},
    {"name": "STT (:8989)", "kind": "http", "probe": "http://127.0.0.1:8989/", "fix": "systemctl --user start voice-stt"},
    {"name": "TTS (:8081)", "kind": "http", "probe": "http://127.0.0.1:8081/health", "fix": "systemctl --user start voice-tts"},
    {"name": "Redis (:6379)", "kind": "tcp", "probe": ["127.0.0.1", 6379], "fix": "cd $BACKEND_DIR && docker compose up -d redis"},
    {"name": "Postgres (:5432)", "kind": "tcp", "probe": ["127.0.0.1", 5432], "fix": "cd $BACKEND_DIR && docker compose up -d postgres"},
    {"name": "Agent worker", "kind": "unit", "probe": "app-worker", "fix": "systemctl --user start app-worker"},
    {"name": "Huey consumer", "kind": "unit", "probe": "app-huey", "fix": "systemctl --user start app-huey"}
  ],
  "systemd_units": ["voice-stt", "voice-tts", "app-worker", "app-huey", "app-website"],
  "docker_containers": {"livekit": "livekit", "postgres": "postgres", "redis": "app-redis-1"}
}
